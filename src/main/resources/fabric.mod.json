{
  "schemaVersion": 1,
  "id": "cebikes",
  "version": "${version}",
  "name": "CEBikes",
  "description": "",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "accessWidener": "cebikes.accesswidener",
  "icon": "assets/cebikes/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.serotonin.cebikes.client.CebikesDataGenerator"
    ],
    "client": [
      "com.serotonin.cebikes.client.CebikesClient"
    ],
    "main": [
      "com.serotonin.cebikes.Cebikes"
    ],
    "lambdynlights:initializer": [
      "com.serotonin.cebikes.client.CebikesDynamicLightsInitializer"
    ],
    "modmenu": [
      "com.serotonin.cebikes.client.compat.ModMenuIntegration"
    ]
  },
  "mixins": [
    "cebikes.mixins.json",
    {
      "config": "cebikes.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "geckolib": "*"
  },
  "suggests": {
    "lambdynamiclights": "*",
    "modmenu": "*",
    "cloth-config": "*",
    "knowlogy": "*"
  }
}
